<Window x:Class="TurnTabler.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="TurnTabler" Width="460" Height="390" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" UseLayoutRounding="True">
    <Window.Resources>
        <LinearGradientBrush x:Key="ChromeStroke" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#BDECF8FF" Offset="0"/><GradientStop Color="#45758CA3" Offset="0.45"/><GradientStop Color="#929CB7C7" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="SmokedGlass" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#B9364856" Offset="0"/><GradientStop Color="#D313202C" Offset="0.52"/><GradientStop Color="#BE253745" Offset="1"/></LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#E8F4FD"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="17"/><Setter Property="Padding" Value="5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#35C9E7FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E8F4FD"/><Setter Property="Margin" Value="0,5"/><Setter Property="FontSize" Value="12"/></Style>
        <Style x:Key="ChromeFader" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Height" Value="22"/><Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Margin="6,0">
                    <Border Height="7" VerticalAlignment="Center" CornerRadius="3.5" Background="#DE0C151E" BorderBrush="#608BA8BA" BorderThickness="1"/>
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Orientation="Horizontal">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" VerticalAlignment="Center" CornerRadius="1.5" Background="#A7D6E8F3"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Background="Transparent"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Width="13" Height="18" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" BorderBrush="#D7E4ECF1" BorderThickness="0.8"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#586D80" Offset="0"/><GradientStop Color="#E6F1F7" Offset="0.2"/><GradientStop Color="#A7BCCB" Offset="0.5"/><GradientStop Color="#F4FAFC" Offset="0.77"/><GradientStop Color="#678195" Offset="1"/></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.7"/></Border.Effect><Border Width="1" Height="9" Background="#AA304757" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GlassToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#BBD1DF"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="ToggleChrome" CornerRadius="5" BorderBrush="{StaticResource ChromeStroke}" BorderThickness="0.7" Background="{StaticResource SmokedGlass}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="#F1FCFF"/><Setter TargetName="ToggleChrome" Property="Background" Value="#B04A879F"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#D6F1FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Viewbox x:Name="WidgetScale" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top">
    <Canvas x:Name="Surface" Width="460" Height="390">
        <Canvas x:Name="Deck" Width="440" Height="293.333" Canvas.Left="10" Canvas.Top="8" Background="#01000000" MouseLeftButtonDown="DragWidget" UseLayoutRounding="False">
            <Grid x:Name="Ambient" Width="440" Height="293.333" Canvas.Left="0" Canvas.Top="0" Opacity="0.75" IsHitTestVisible="False">
                <Grid.Clip>
                    <PathGeometry Figures="M157,66 H1362 Q1469,66 1469,175 V850 Q1469,958 1364,958 H158 Q61,958 61,852 V172 Q61,66 157,66 Z">
                        <PathGeometry.Transform><ScaleTransform ScaleX="0.2864583333333333" ScaleY="0.2864583333333333"/></PathGeometry.Transform>
                    </PathGeometry>
                </Grid.Clip>
                <Grid.OpacityMask><RadialGradientBrush RadiusX="0.69" RadiusY="0.7"><GradientStop Color="White" Offset="0.5"/><GradientStop Color="#CFFFFFFF" Offset="0.83"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Grid.OpacityMask>
                <Image x:Name="AmbientA" Stretch="Fill" Opacity="0"><Image.Effect><BlurEffect Radius="33"/></Image.Effect></Image>
                <Image x:Name="AmbientB" Stretch="Fill" Opacity="0"><Image.Effect><BlurEffect Radius="33"/></Image.Effect></Image>
            </Grid>
            <Grid x:Name="Record" Width="265.2" Height="265.2" Canvas.Left="57.6" Canvas.Top="6.9" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Grid.RenderTransform><RotateTransform x:Name="RecordRotation"/></Grid.RenderTransform>
                <Ellipse Fill="#101113"/>
                <Image x:Name="RecordTexture" Stretch="Fill"><Image.Clip><EllipseGeometry Center="132.6,132.6" RadiusX="132.6" RadiusY="132.6"/></Image.Clip></Image>
            </Grid>
            <Grid x:Name="Projection" Width="259.2" Height="259.2" Canvas.Left="60.6" Canvas.Top="9.9" Background="Transparent">
                <Grid.Clip><EllipseGeometry Center="129.6,129.6" RadiusX="129.6" RadiusY="129.6"/></Grid.Clip>
                <Grid.OpacityMask><RadialGradientBrush RadiusX="0.5" RadiusY="0.5"><GradientStop Color="White" Offset="0.75"/><GradientStop Color="#F0FFFFFF" Offset="0.93"/><GradientStop Color="#00FFFFFF" Offset="1"/></RadialGradientBrush></Grid.OpacityMask>
                <Viewbox x:Name="VideoViewbox" Width="460.8" Height="259.2" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                    <wv:WebView2CompositionControl x:Name="Browser" Width="960" Height="540" DefaultBackgroundColor="Black" AllowExternalDrop="False"/>
                </Viewbox>
                <Rectangle x:Name="Film" IsHitTestVisible="False" Opacity="0.045"><Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="Black" Geometry="M0,0 L3,0 3,0.5 0,0.5Z"/></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle>
                <Button x:Name="VideoHit" Click="TogglePlayback" Background="#01000000" ToolTip="재생 / 일시정지"/>
            </Grid>
            <Canvas x:Name="GrooveOverlay" Width="265.2" Height="265.2" Canvas.Left="57.6" Canvas.Top="6.9" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
                <Canvas.RenderTransform><RotateTransform x:Name="GrooveRotation"/></Canvas.RenderTransform>
                <Image x:Name="GrooveHighlights" Width="265.2" Height="265.2" Opacity="0.6"/>
                <Path Stroke="#66D5E2E9" StrokeThickness="0.65" Data="M133,7 A126,126 0 0 1 173,14"/>
            </Canvas>
            <Image x:Name="GlassBody" Width="440" Height="293.333" IsHitTestVisible="False"/>
            <Image x:Name="Tonearm" Width="440" Height="293.333" IsHitTestVisible="False"><Image.RenderTransform><RotateTransform Angle="3" CenterX="368.671875" CenterY="100.546875"/></Image.RenderTransform></Image>
            <Button x:Name="SettingsButton" Content="⚙" Width="29" Height="29" Canvas.Left="397" Canvas.Top="17" Click="ToggleSettings" ToolTip="설정" FontSize="19"/>
            <ToggleButton x:Name="CaptionsButton" Content="CC" Canvas.Left="377" Canvas.Top="205" Width="30" Height="19" Style="{StaticResource GlassToggle}" Click="CaptionsChanged" ToolTip="자막 켜기 / 끄기" AutomationProperties.Name="자막 켜기 또는 끄기"/>
            <Border x:Name="VolumeHousing" Canvas.Left="307" Canvas.Top="231" Width="108" Height="25" CornerRadius="7" BorderBrush="{StaticResource ChromeStroke}" BorderThickness="0.7" Background="{StaticResource SmokedGlass}" Padding="7,0,4,0">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M1,6 L4,6 8,2 8,14 4,10 1,10Z M10,5 Q14,8 10,11" Stroke="#C3DCE8" StrokeThickness="1" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"/><Slider x:Name="Volume" Grid.Column="1" Minimum="0" Maximum="100" Value="65" Style="{StaticResource ChromeFader}" VerticalAlignment="Center" ValueChanged="ChangeVolume" ToolTip="음량"/></Grid>
            </Border>
        </Canvas>
        <Border x:Name="TransportBar" Canvas.Left="30" Canvas.Top="283" Width="400" Height="34" CornerRadius="10" BorderBrush="{StaticResource ChromeStroke}" BorderThickness="0.8" Background="{StaticResource SmokedGlass}" Padding="4,1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="28"/><ColumnDefinition Width="26"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="27"/></Grid.ColumnDefinitions>
                <Button x:Name="Previous" Content="‹" Click="PreviousTrack" ToolTip="이전 영상" IsEnabled="False" FontSize="21" Padding="2"/>
                <Button x:Name="Play" Content="▶" Grid.Column="1" Click="TogglePlayback" ToolTip="재생 / 일시정지" FontSize="11" Padding="2"/>
                <Button x:Name="Next" Content="›" Grid.Column="2" Click="NextTrack" ToolTip="다음 영상" IsEnabled="False" FontSize="21" Padding="2"/>
                <Border Grid.Column="3" Width="1" Height="15" Background="#477891A7"/>
                <Grid Grid.Column="4"><TextBlock Text="YouTube 링크 붙여넣기" Foreground="#85B4C7D5" FontSize="10" VerticalAlignment="Center" Margin="5,0" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Address}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox x:Name="Address" VerticalContentAlignment="Center" FontSize="10.5" Padding="5,2" BorderThickness="0" Background="Transparent" Foreground="#DEEFF7" CaretBrush="White" SelectionBrush="#628DAC" KeyDown="AddressKeyDown" ToolTip="유튜브 링크를 붙여 넣고 Enter"/></Grid>
                <Button Content="↵" Grid.Column="5" Click="SubmitAddress" ToolTip="링크 재생" FontSize="14" Padding="2"/>
                <Button x:Name="PlaylistButton" Content="≡" Grid.Column="6" Click="TogglePlaylist" ToolTip="재생목록" FontSize="18" Padding="2" IsEnabled="False"/>
            </Grid>
        </Border>
        <TextBlock x:Name="TrackTitle" Canvas.Left="46" Canvas.Top="324" Width="367" Foreground="#D8E7F0" FontSize="10" TextTrimming="CharacterEllipsis" TextAlignment="Center"><TextBlock.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="1"/></TextBlock.Effect></TextBlock>
        <Border x:Name="StatusBox" Canvas.Left="32" Canvas.Top="344" Width="396" CornerRadius="7" Background="#DE202832" Padding="7,5" Visibility="Collapsed"><TextBlock x:Name="StatusText" Foreground="#FFE4CA" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/></Border>
        <Border x:Name="PlaylistPanel" Canvas.Left="42" Canvas.Top="71" Width="376" Height="204" CornerRadius="12" Background="#F0192936" BorderBrush="{StaticResource ChromeStroke}" BorderThickness="0.8" Padding="12" Visibility="Collapsed">
            <DockPanel><DockPanel DockPanel.Dock="Top" Height="27" Margin="0,0,0,7"><Button Content="×" DockPanel.Dock="Right" Width="24" Click="TogglePlaylist"/><TextBlock x:Name="PlaylistHeading" Text="재생목록" Foreground="#E1EFF7" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <ListBox x:Name="PlaylistTracks" Background="Transparent" BorderThickness="0" Foreground="#D2E2ED" SelectionChanged="SelectPlaylistTrack" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.Resources><Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" ViewportSize="{TemplateBinding ViewportSize}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="#7F9DB5C8" Margin="1,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style></ListBox.Resources>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="7,6"/><Setter Property="Margin" Value="0,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Row" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#6A49728A"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#54799AB0"/><Setter TargetName="Row" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><DockPanel><TextBlock Text="{Binding Number}" Width="26" FontSize="10" Foreground="#8FBCD2"/><TextBlock Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <Border x:Name="SettingsPanel" Canvas.Left="188" Canvas.Top="46" Width="242" Background="#F51D2735" BorderBrush="#508EA6BA" BorderThickness="1" CornerRadius="12" Padding="15" Visibility="Collapsed">
            <StackPanel>
                <DockPanel><Button Content="×" DockPanel.Dock="Right" Click="ToggleSettings" Width="27"/><TextBlock Text="설정" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                <CheckBox x:Name="PinOption" Content="항상 위에 표시" IsChecked="True" Click="OptionsChanged"/>
                <CheckBox x:Name="RotationOption" Content="레코드 천천히 회전" IsChecked="True" Click="OptionsChanged"/>
                <CheckBox x:Name="EffectOption" Content="프로젝터 효과" IsChecked="True" Click="OptionsChanged"/>
                <CheckBox x:Name="AmbientOption" Content="영상 색 반사" IsChecked="True" Click="OptionsChanged"/>
                <DockPanel Margin="0,5"><TextBlock Text="빛 퍼짐" Foreground="White" VerticalAlignment="Center"/><Slider x:Name="LightStrength" Minimum="0" Maximum="100" Value="75" Width="115" Style="{StaticResource ChromeFader}" HorizontalAlignment="Right" ValueChanged="LightStrengthChanged"/></DockPanel>
                <DockPanel Margin="0,5"><TextBlock Text="크기" Foreground="White" VerticalAlignment="Center"/><ComboBox x:Name="SizeOption" Width="109" HorizontalAlignment="Right" SelectedIndex="1" SelectionChanged="WidgetSizeChanged"><ComboBoxItem Content="작게"/><ComboBoxItem Content="보통"/><ComboBoxItem Content="크게"/></ComboBox></DockPanel>
                <Button Content="유튜브 페이지 보기" FontSize="12" Click="OpenYouTubePage" Margin="0,5" ToolTip="로그인·동의·재생목록을 원래 페이지에서 조작"/>
                <Button Content="오른쪽 아래로 정렬" FontSize="12" Click="DockWidget" Margin="0,5"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0"><Button Content="숨기기" Click="HideWidget" FontSize="12" Margin="0,0,12,0"/><Button Content="종료" Click="CloseWidget" FontSize="12"/></StackPanel>
            </StackPanel>
        </Border>
    </Canvas>
    </Viewbox>
</Window>
