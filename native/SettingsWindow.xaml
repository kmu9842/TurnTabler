<Window x:Class="TurnTabler.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TurnTabler 설정" Width="320" Height="542" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="Manual" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="GlassTheme.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEFFFFFF"/><Setter Property="FontSize" Value="12"/></Style>
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="#EEFFFFFF"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/><Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center"/>
                        <Border x:Name="Switch" Grid.Column="1" Height="16" CornerRadius="8" Background="#12FFFFFF" BorderBrush="#60FFFFFF" BorderThickness=".8" VerticalAlignment="Center">
                            <Ellipse x:Name="Knob" Width="10" Height="10" Fill="#99FFFFFF" HorizontalAlignment="Left" Margin="2"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Switch" Property="Background" Value="#38FFFFFF"/><Setter TargetName="Switch" Property="BorderBrush" Value="#CFFFFFFF"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Fill" Value="White"/></Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="White"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Switch" Property="BorderBrush" Value="White"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SizeChoice" TargetType="RadioButton">
                <Setter Property="Foreground" Value="#BFFFFFFF"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Height" Value="29"/>
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Choice" CornerRadius="5" Margin="2" Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="#27FFFFFF"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#18FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#90FFFFFF"/><Setter TargetName="Choice" Property="BorderThickness" Value=".8"/></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="SettingsAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/></Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Padding="18,12,18,14" CornerRadius="12" Background="#EB1C1C1C" BorderBrush="{StaticResource ChromeStroke}" BorderThickness=".8">
        <Grid><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Background="Transparent" MouseLeftButtonDown="DragHeader">
                <Button Width="28" Height="28" Padding="0" DockPanel.Dock="Right" Click="CloseSettings" ToolTip="닫기" AutomationProperties.Name="설정 닫기"><Path Data="M1,1 L9,9 M9,1 L1,9" Width="10" Height="10" Stroke="#EEFFFFFF" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
                <TextBlock Text="설정" FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>
            <ScrollViewer Grid.Row="1" Margin="0,15,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <DockPanel Margin="0,0,0,7"><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right"/><TextBlock Text="영상 불투명도"/></DockPanel>
                    <Slider x:Name="VideoOpacity" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ChromeFader}" ToolTip="0%: 투명 · 100%: 불투명" AutomationProperties.Name="영상 불투명도"/>
                    <DockPanel Margin="6,5,6,0"><TextBlock Text="불투명" DockPanel.Dock="Right" Foreground="#AFFFFFFF" FontSize="10"/><TextBlock Text="투명" Foreground="#AFFFFFFF" FontSize="10"/></DockPanel>
                    <Border Height="1" Background="#24FFFFFF" Margin="0,16,0,8"/>
                    <CheckBox x:Name="PinOption" Content="항상 위에 표시"/>
                    <CheckBox x:Name="RotationOption" Content="레코드 천천히 회전"/>
                    <CheckBox x:Name="EffectOption" Content="프로젝터 효과"/>
                    <CheckBox x:Name="AmbientOption" Content="영상 색 반사"/>
                    <DockPanel Margin="0,12,0,7"><TextBlock x:Name="LightValue" DockPanel.Dock="Right"/><TextBlock Text="빛 퍼짐"/></DockPanel>
                    <Slider x:Name="LightStrength" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Style="{StaticResource ChromeFader}" AutomationProperties.Name="빛 퍼짐"/>
                    <DockPanel Margin="0,12,0,0"><TextBlock Text="크기" VerticalAlignment="Center"/>
                        <Border Width="181" HorizontalAlignment="Right" CornerRadius="7" Background="#08FFFFFF" BorderBrush="#38FFFFFF" BorderThickness=".8"><UniformGrid Rows="1">
                            <RadioButton x:Name="SmallSize" Content="작게" GroupName="WidgetSize" Style="{StaticResource SizeChoice}"/>
                            <RadioButton x:Name="NormalSize" Content="보통" GroupName="WidgetSize" Style="{StaticResource SizeChoice}"/>
                            <RadioButton x:Name="LargeSize" Content="크게" GroupName="WidgetSize" Style="{StaticResource SizeChoice}"/>
                        </UniformGrid></Border>
                    </DockPanel>
                    <Border Height="1" Background="#24FFFFFF" Margin="0,16,0,8"/>
                    <Button x:Name="YouTubePageButton" Content="유튜브 페이지 보기" Style="{StaticResource SettingsAction}" ToolTip="로그인·동의·재생목록을 원래 페이지에서 조작"/>
                    <Button x:Name="DockButton" Content="오른쪽 아래로 정렬" Style="{StaticResource SettingsAction}"/>
                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button x:Name="HideButton" Content="숨기기" Style="{StaticResource SettingsAction}"/>
                        <Button x:Name="ExitButton" Content="종료" Grid.Column="1" Style="{StaticResource SettingsAction}"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
