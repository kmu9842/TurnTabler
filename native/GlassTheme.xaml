<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
        <LinearGradientBrush x:Key="ChromeStroke" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#BFFFFFFF" Offset="0"/><GradientStop Color="#35FFFFFF" Offset="0.45"/><GradientStop Color="#90FFFFFF" Offset="1"/></LinearGradientBrush>
        <LinearGradientBrush x:Key="ClearGlass" StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#14FFFFFF" Offset="0"/><GradientStop Color="#03FFFFFF" Offset="0.25"/><GradientStop Color="#00FFFFFF" Offset="0.75"/><GradientStop Color="#0FFFFFFF" Offset="1"/></LinearGradientBrush>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEFFFFFF"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="17"/><Setter Property="Padding" Value="5"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#20FFFFFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="TransportIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0"/><Setter Property="Height" Value="26"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <Grid Width="12" Height="12"><Path x:Name="Glyph" Data="M3,1 L11,6 3,11 Z" Fill="#EEFFFFFF" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding}" Value="Ⅱ"><Setter TargetName="Glyph" Property="Data" Value="M2,1 H5 V11 H2 Z M7,1 H10 V11 H7 Z"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="‹"><Setter TargetName="Glyph" Property="Data" Value="M8,1 L3,6 8,11"/><Setter TargetName="Glyph" Property="Fill" Value="Transparent"/><Setter TargetName="Glyph" Property="Stroke" Value="#EEFFFFFF"/><Setter TargetName="Glyph" Property="StrokeThickness" Value="1.4"/></DataTrigger>
                    <DataTrigger Binding="{Binding}" Value="›"><Setter TargetName="Glyph" Property="Data" Value="M4,1 L9,6 4,11"/><Setter TargetName="Glyph" Property="Fill" Value="Transparent"/><Setter TargetName="Glyph" Property="Stroke" Value="#EEFFFFFF"/><Setter TargetName="Glyph" Property="StrokeThickness" Value="1.4"/></DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ChromeFader" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/><Setter Property="Height" Value="22"/><Setter Property="SmallChange" Value="1"/><Setter Property="LargeChange" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
                <Grid Margin="6,0">
                    <Border Height="5" VerticalAlignment="Center" CornerRadius="2.5" Background="#08000000" BorderBrush="#38FFFFFF" BorderThickness="0.7"/>
                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Orientation="Horizontal">
                        <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="2" VerticalAlignment="Center" CornerRadius="1" Background="#70FFFFFF"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Background="Transparent"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                        <Track.Thumb><Thumb Width="13" Height="18" Cursor="Hand"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" BorderBrush="#CFFFFFFF" BorderThickness="0.8"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#40FFFFFF" Offset="0"/><GradientStop Color="#08FFFFFF" Offset="0.3"/><GradientStop Color="#00FFFFFF" Offset="0.6"/><GradientStop Color="#30FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.25"/></Border.Effect><Border Width="1" Height="8" Background="#A0FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GlassToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#AFFFFFFF"/><Setter Property="FontSize" Value="9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="ToggleChrome" CornerRadius="5" BorderBrush="{StaticResource ChromeStroke}" BorderThickness="0.7" Background="{StaticResource ClearGlass}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><Border x:Name="OnMark" Width="11" Height="1" Background="White" VerticalAlignment="Bottom" Margin="0,0,0,2" Visibility="Collapsed"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="ToggleChrome" Property="BorderBrush" Value="#EEFFFFFF"/><Setter TargetName="OnMark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ToggleChrome" Property="BorderBrush" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
</ResourceDictionary>
