{
  "name": "turntabler",
  "version": "2.1.0",
  "private": true,
  "description": "Native Windows turntable widget (WPF + Windows WebView2)",
  "scripts": {
    "start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-native.ps1",
